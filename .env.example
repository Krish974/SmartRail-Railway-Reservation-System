# Smart Indian Railway System - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local or cloud environments

# ==============================================================================
# Database Settings
# ==============================================================================
# For Cloud Production (PostgreSQL):
# Supply DATABASE_URL (provided automatically by Render, Railway, Heroku, Supabase, Neon)
# Example: postgresql://username:password@hostname:5432/railway_db
# DATABASE_URL=postgresql://username:password@hostname:5432/railway_db

# Database Type Selection: 'postgres', 'mysql', 'sqlite', or 'auto'
# When DATABASE_URL is set, DB_TYPE automatically defaults to 'postgres'.
# In local dev without DATABASE_URL/MySQL, it seamlessly falls back to SQLite.
DB_TYPE=auto

# MySQL Settings (Alternative external database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=railway_db

# ==============================================================================
# Security & Application Settings
# ==============================================================================
# Set a strong, unique secret key for session signing in production
SECRET_KEY=your-secure-random-secret-key-here
FLASK_ENV=development               # Set to 'production' on cloud hosts
FLASK_DEBUG=0                       # Set to 0 in production
PORT=5000                           # Port assigned by cloud host (Render/Railway/Heroku injects PORT automatically)
SESSION_COOKIE_SECURE=0             # Set to 1 when serving over HTTPS

# ==============================================================================
# RailRadar Live Telemetry & Tracking API (https://railradar.in)
# ==============================================================================
RAILRADAR_API_KEY=your_railradar_api_key_here
RAILRADAR_BASE_URL=https://api.railradar.in
RAILRADAR_ROUTE_DELAY=1.0

# ==============================================================================
# Qrail API Integration (Optional / Fallback)
# ==============================================================================
QRAIL_API_KEY=your_qrail_api_key_here
QRAIL_BASE_URL=https://api.qrail.in
QRAIL_IMPORT_LIMIT=5
